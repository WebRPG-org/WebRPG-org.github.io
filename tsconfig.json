{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", ".cache", "node_modules", "src/App.tsx", "src/main.tsx"]
}
