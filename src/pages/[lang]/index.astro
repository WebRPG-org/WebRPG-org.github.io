---
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import { LOCALES, type Locale } from "../../i18n/ui";
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const locale = Astro.params.lang as Locale;
---
<CatalogLayout locale={locale} route={{kind:"home"}} />
