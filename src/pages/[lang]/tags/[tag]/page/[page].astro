---
import CatalogLayout from "../../../../../layouts/CatalogLayout.astro";
import { LOCALES, UI, taxonomyLabel, tagDescription, type Locale } from "../../../../../i18n/ui";
import { tags, filterCatalog, pageCount } from "../../../../../data/catalog";
export function getStaticPaths() {
  return LOCALES.flatMap((lang) => tags.flatMap((tag) => Array.from({length: Math.max(0, pageCount(filterCatalog("tags",tag))-1)}, (_, i) => ({
    params: {lang,tag,page:String(i+2)}
  }))));
}
const locale = Astro.params.lang as Locale;
const tag = String(Astro.params.tag);
const page = Number(Astro.params.page);
const games = filterCatalog("tags",tag);
const title = taxonomyLabel(tag,locale) + " — " + UI[locale].genres + " (" + page + ")";
const description = (tagDescription(tag,locale,games.length) || title) + " · " + UI[locale].page + " " + page;
---
<CatalogLayout locale={locale} games={games} route={{kind:"tags",slug:tag,page}} page={page} title={title} description={description} indexable={games.length >= 2 && !!tagDescription(tag,locale,games.length)} />
