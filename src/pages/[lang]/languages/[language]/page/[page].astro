---
import CatalogLayout from "../../../../../layouts/CatalogLayout.astro";
import { LOCALES, UI, langLabel, playableLanguageDescription, type Locale } from "../../../../../i18n/ui";
import { languages, filterCatalog, pageCount } from "../../../../../data/catalog";
export function getStaticPaths() {
  return LOCALES.flatMap((lang) => languages.flatMap((language) => Array.from({length: Math.max(0, pageCount(filterCatalog("languages",language))-1)}, (_, i) => ({
    params:{lang,language,page:String(i+2)}
  }))));
}
const locale = Astro.params.lang as Locale;
const language = String(Astro.params.language);
const page = Number(Astro.params.page);
const games = filterCatalog("languages",language);
const title = langLabel(language,locale) + " — " + UI[locale].languages + " (" + page + ")";
---
<CatalogLayout locale={locale} games={games} route={{kind:"languages",slug:language,page}} page={page} title={title} description={playableLanguageDescription(language,locale,games.length) + " · " + UI[locale].page + " " + page} indexable={games.length>=2} />
