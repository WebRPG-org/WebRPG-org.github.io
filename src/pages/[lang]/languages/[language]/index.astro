---
import CatalogLayout from "../../../../layouts/CatalogLayout.astro";
import { LOCALES, UI, langLabel, playableLanguageDescription, type Locale } from "../../../../i18n/ui";
import { languages, filterCatalog } from "../../../../data/catalog";
export function getStaticPaths() {
  return LOCALES.flatMap((lang) => languages.map((language) => ({params: {lang,language}})));
}
const locale = Astro.params.lang as Locale;
const language = String(Astro.params.language);
const games = filterCatalog("languages",language);
const title = langLabel(language,locale) + " — " + UI[locale].languages;
const description = playableLanguageDescription(language,locale,games.length);
---
<CatalogLayout locale={locale} games={games} route={{kind:"languages",slug:language,page:1}} title={title} description={description} indexable={games.length>=2} />
