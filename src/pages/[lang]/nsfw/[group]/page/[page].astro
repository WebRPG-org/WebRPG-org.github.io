---
import CatalogLayout from "../../../../../layouts/CatalogLayout.astro";
import { LOCALES, UI, type Locale } from "../../../../../i18n/ui";
import { filterNsfw, nsfwGroups, pageCount, type NsfwGroup } from "../../../../../data/catalog";
export function getStaticPaths() {
  return LOCALES.flatMap((lang) => nsfwGroups.flatMap((group) =>
    Array.from({length:Math.max(0,pageCount(filterNsfw(group))-1)},(_,i)=>({
      params:{lang,group,page:String(i+2)}
    }))));
}
const locale=Astro.params.lang as Locale;
const group=Astro.params.group as NsfwGroup;
const page=Number(Astro.params.page);
const games=filterNsfw(group);
const copy=UI[locale];
const title=copy.nsfwFilter+" — "+(group==="safe"?copy.safe:group==="adult"?copy.adult:copy.unknown)+" ("+page+")";
---
<CatalogLayout locale={locale} games={games} route={{kind:"nsfw",slug:group,page}} page={page}
  title={title} description={title+" · "+games.length+" "+copy.gameCount+" · WebRPG"} indexable={false} />
