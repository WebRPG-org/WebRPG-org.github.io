---
import CatalogLayout from "../../../layouts/CatalogLayout.astro";
import { LOCALES, UI, type Locale } from "../../../i18n/ui";
import { catalog, pageCount } from "../../../data/catalog";
export function getStaticPaths() {
  return LOCALES.flatMap((lang) => Array.from({length: Math.max(0, pageCount(catalog.games)-1)}, (_, i) => ({
    params: {lang, page: String(i + 2) }
  })));
}
const locale = Astro.params.lang as Locale;
const page = Number(Astro.params.page);
---
<CatalogLayout locale={locale} route={{kind:"page",page}} page={page} title={UI[locale].catalog + " (" + page + ")"} />
