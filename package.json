{
  "name": "webrpg-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:data && astro dev --host",
    "build": "npm run prepare:data && astro build && node scripts/verify-dist.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "npm run prepare:data && astro check",
    "preview": "astro preview --host",
    "prepare:data": "node scripts/build-catalog.mjs",
    "test": "npm run prepare:data && node --test tests/*.test.mjs",
    "ci": "npm run prepare:data && npm run lint && npx astro check && node --test tests/*.test.mjs && npx astro build && node scripts/verify-dist.mjs",
    "test:browser": "node scripts/run-browser-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.2",
    "lucide-react": "^1.18.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "shadcn": "^4.11.0",
    "@astrojs/check": "^0.9.12"
  }
}
